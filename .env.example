# ============================================================
# SelaVoice — variáveis de ambiente (copie para .env e preencha)
# NUNCA faça commit do .env. Segredos existem SOMENTE no backend.
# ============================================================
APP_ENV=development            # development | test | production

# --- Banco / cache ---
# Local sem Docker: SQLite. Produção/Compose: PostgreSQL 16.
DATABASE_URL=sqlite:///./selavoice.db
# DATABASE_URL=postgresql+psycopg://selavoice:TROQUE@postgres:5432/selavoice
POSTGRES_PASSWORD=troque-esta-senha
REDIS_URL=

# --- Segurança (OBRIGATÓRIO em produção; a API não sobe sem isto) ---
# Gerar: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=
# Gerar: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# --- Super admin inicial (senha vazia = gerada aleatória no seed) ---
SUPER_ADMIN_EMAIL=admin@selavoice.local
SUPER_ADMIN_PASSWORD=

# --- Stripe (comece em modo teste; 'fake' não precisa de chave) ---
STRIPE_MODE=fake               # fake | test | live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_dev_fake_secret

# --- Provedores de IA (vazio = simulador; ver docs/BLOCKERS.md) ---
GEMINI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
DEEPGRAM_API_KEY=
DEEPSEEK_API_KEY=              # SOMENTE edição editorial, nunca tradução

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
